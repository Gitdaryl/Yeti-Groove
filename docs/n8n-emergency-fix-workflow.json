{
  "name": "Yeti Groove Emergency Fix Agent",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "yeti-emergency-fix",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "yeti-emergency-fix"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://yetigroove.com/api/fix-analyze",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Content-Type", "value": "application/json" }]
        },
        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={{ JSON.stringify({ repo: $json.body.repo, filePath: $json.body.filePath, branch: $json.body.branch || 'main', instruction: $json.body.instruction, token: $env.FIX_AUTH_TOKEN }) }}",
        "options": { "timeout": 60000 }
      },
      "id": "analyze",
      "name": "Analyze Fix (Claude)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [{
            "leftValue": "={{ $json.complexity }}",
            "rightValue": "complex",
            "operator": { "type": "string", "operation": "equals" }
          }],
          "combinator": "and"
        }
      },
      "id": "complexity-check",
      "name": "Complex?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "from": "={{ $env.TWILIO_PHONE }}",
        "to": "={{ $env.DARYL_PHONE }}",
        "message": "YETI FIX WARNING: Complex fix detected.\nFile: {{ $('Analyze Fix (Claude)').item.json.filePath }}\nModel: {{ $('Analyze Fix (Claude)').item.json.modelUsed }}\n{{ $('Analyze Fix (Claude)').item.json.explanation }}\nReview at https://yetigroove.com/fix before confirming."
      },
      "id": "sms-warn",
      "name": "SMS Warning",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [900, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($('Analyze Fix (Claude)').item.json) }}"
      },
      "id": "respond-diff",
      "name": "Return Diff",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [900, 400]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "yeti-emergency-fix-confirm",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "confirm-trigger",
      "name": "Confirm Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 560],
      "webhookId": "yeti-emergency-fix-confirm"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://yetigroove.com/api/fix-commit",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Content-Type", "value": "application/json" }]
        },
        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={{ JSON.stringify(Object.assign({}, $json.body, { token: $env.FIX_AUTH_TOKEN })) }}",
        "options": { "timeout": 30000 }
      },
      "id": "commit",
      "name": "Commit & PR",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 560]
    },
    {
      "parameters": {
        "from": "={{ $env.TWILIO_PHONE }}",
        "to": "={{ $env.DARYL_PHONE }}",
        "message": "YETI FIX DONE - PR created.\n{{ $json.prUrl }}\nMerge to deploy."
      },
      "id": "sms-done",
      "name": "SMS Success",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [680, 560]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($('Commit & PR').item.json) }}"
      },
      "id": "respond-pr",
      "name": "Return PR URL",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [900, 560]
    }
  ],
  "connections": {
    "Webhook Trigger":        { "main": [[{ "node": "Analyze Fix (Claude)", "type": "main", "index": 0 }]] },
    "Analyze Fix (Claude)":   { "main": [[{ "node": "Complex?", "type": "main", "index": 0 }]] },
    "Complex?": {
      "main": [
        [{ "node": "SMS Warning", "type": "main", "index": 0 }],
        [{ "node": "Return Diff", "type": "main", "index": 0 }]
      ]
    },
    "SMS Warning":            { "main": [[{ "node": "Return Diff",  "type": "main", "index": 0 }]] },
    "Confirm Webhook":        { "main": [[{ "node": "Commit & PR",  "type": "main", "index": 0 }]] },
    "Commit & PR":            { "main": [[{ "node": "SMS Success",  "type": "main", "index": 0 }]] },
    "SMS Success":            { "main": [[{ "node": "Return PR URL","type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "meta": { "instanceId": "yeti-groove-emergency-fix" },
  "id": "yeti-emergency-fix-workflow",
  "tags": [{ "name": "emergency-fix" }]
}
