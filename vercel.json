{
  "rewrites": [
    {
      "source": "/partners/lake-access",
      "destination": "/partners/lake-access.html"
    },
    {
      "source": "/fix",
      "destination": "/fix.html"
    },
    {
      "source": "/social",
      "destination": "/social.html"
    },
    {
      "source": "/signature",
      "destination": "/signature.html"
    },
    {
      "source": "/architects",
      "destination": "/architects.html"
    },
    {
      "source": "/signature/architects",
      "destination": "/architects.html"
    },
    {
      "source": "/signature/:slug",
      "destination": "/signature.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/sms-policy",
      "destination": "/sms-policy.html"
    },
    {
      "source": "/films",
      "destination": "/signature.html"
    },
    {
      "source": "/lakeaccess",
      "destination": "/lakeaccess.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/platform",
      "destination": "/platform.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/health-alert",
      "schedule": "0 13 * * *"
    }
  ]
}
