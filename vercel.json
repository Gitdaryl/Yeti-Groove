{
  "rewrites": [
    { "source": "/partners/lake-access", "destination": "/partners/lake-access.html" },
    { "source": "/fix",                  "destination": "/fix.html" },
    { "source": "/social",               "destination": "/social.html" },
    { "source": "/lakeaccess",           "destination": "/lakeaccess.html" },
    { "source": "/admin",                "destination": "/admin.html" },
    { "source": "/(.*)",                 "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/health-alert", "schedule": "0 13 * * *" }
  ]
}
